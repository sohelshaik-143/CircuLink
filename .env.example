# ==============================================================================
# CircuLink Platform — Environment Configuration Template
# RGUKT Official Campus Intelligence & Communications Platform
# ==============================================================================

# Database Configuration (MySQL 8)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/circulink
DB_USER=root
DB_PASSWORD=
DB_NAME=circulink
DB_HOST=127.0.0.1
DB_PORT=3306

# Server Port
PORT=5000

# Security & Cryptography (Ensure at least 256 bits in production)
JWT_SECRET=your_jwt_secret_key_at_least_256_bits
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key
REFRESH_TOKEN_EXPIRE=30d

# Frontend Client URL (CORS Whitelist)
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Google OAuth 2.0 Credentials (RGUKT domain whitelisted)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend Vite Environment Variables (expose to client)
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
